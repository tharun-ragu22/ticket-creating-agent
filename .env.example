# ─── LiveKit transport ────────────────────────────────────────────────────────
# From cloud.livekit.io → your project → Settings → Keys
LIVEKIT_URL=wss://your-project-xxxxxxxx.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=ticket-agent

# ─── Voice stack (swap any of these without touching code) ───────────────────
VOICE_LANGUAGE=en
VOICE_VAD_PROVIDER=silero
VOICE_STT_PROVIDER=deepgram        # deepgram | assemblyai | cartesia | inference
VOICE_STT_MODEL=nova-3
VOICE_LLM_PROVIDER=anthropic       # anthropic | openai | google | inference
VOICE_LLM_MODEL=claude-sonnet-4-6
VOICE_LLM_TEMPERATURE=0.3
VOICE_TTS_PROVIDER=elevenlabs      # elevenlabs | cartesia | deepgram | rime | inference
VOICE_TTS_MODEL=eleven_flash_v2_5
VOICE_TTS_VOICE=
VOICE_LLM_FALLBACK=                # e.g. openai:gpt-4.1-mini

# ─── Vendor keys ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
CARTESIA_API_KEY=

# ─── Ticketing ────────────────────────────────────────────────────────────────
TICKET_PROVIDER=demo               # demo | synergy-interact
TICKET_API_URL=http://127.0.0.1:8080
TICKET_API_SERVICE_TOKEN=dev-service-token
DATABASE_URL=postgres://tca:tca@127.0.0.1:5432/tca

# ─── Identity ─────────────────────────────────────────────────────────────────
IDENTITY_PROVIDER=demo-jwt         # demo-jwt | oidc
CALLER_DIRECTORY=demo-seed         # demo-seed | entra-graph | okta
DEMO_JWT_SECRET=change-me-in-dev

# ─── Evals (tier 6) ───────────────────────────────────────────────────────────
EVAL_LLM_MODEL=google/gemma-4-31b-it   # small + cheap, via LiveKit Inference
