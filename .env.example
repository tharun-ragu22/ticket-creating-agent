# ─── LiveKit transport ────────────────────────────────────────────────────────
# From cloud.livekit.io → your project → Settings → Keys
LIVEKIT_URL=wss://your-project-xxxxxxxx.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=ticket-agent

# ─── Voice stack (swap any of these without touching code) ───────────────────
#
# Defaults route every stage through LiveKit Inference, which authenticates
# with LIVEKIT_API_KEY — so this works with no vendor keys at all.
#
# When provider=inference the model must be "vendor/model", and the gateway
# only serves these vendors (checked at startup by loadVoiceConfig, because an
# unserved vendor is rejected with an EMPTY error message mid-call):
#   STT  assemblyai cartesia deepgram google inworld speechmatics xai
#   LLM  deepseek-ai google moonshotai openai xai zai   (NO anthropic)
#   TTS  assemblyai cartesia deepgram fishaudio inworld rime xai  (NO elevenlabs)
#
# To use anthropic or elevenlabs, select them as the provider directly and
# supply the matching key below.
VOICE_LANGUAGE=en
VOICE_VAD_PROVIDER=silero
VOICE_STT_PROVIDER=inference       # deepgram | assemblyai | cartesia | inference
VOICE_STT_MODEL=deepgram/nova-3
VOICE_LLM_PROVIDER=inference       # anthropic | openai | google | inference
VOICE_LLM_MODEL=google/gemini-2.5-flash
VOICE_LLM_TEMPERATURE=0.3
VOICE_TTS_PROVIDER=inference       # elevenlabs | cartesia | deepgram | rime | inference
VOICE_TTS_MODEL=deepgram/aura-2
VOICE_TTS_VOICE=                   # optional; the gateway takes it as model:voice
VOICE_LLM_FALLBACK=                # e.g. openai:gpt-4.1-mini

# ─── Vendor keys ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
CARTESIA_API_KEY=

# ─── Ticketing ────────────────────────────────────────────────────────────────
TICKET_PROVIDER=demo               # demo | synergy-interact
TICKET_API_URL=http://127.0.0.1:8080
TICKET_API_SERVICE_TOKEN=dev-service-token
# pglite://<path> is real Postgres compiled to WASM: no Docker, no server,
# persists across restarts. Use postgres://… for anything beyond one machine.
DATABASE_URL=pglite://./data/tca

API_HOST=127.0.0.1
API_PORT=8080
API_LOG_LEVEL=info
API_PUBLIC_BASE_URL=http://127.0.0.1:8080

# ─── Identity ─────────────────────────────────────────────────────────────────
IDENTITY_PROVIDER=demo-jwt         # demo-jwt | oidc
CALLER_DIRECTORY=demo-seed         # demo-seed | entra-graph | okta
DEMO_JWT_SECRET=change-me-in-dev

# ─── Evals (tier 6) ───────────────────────────────────────────────────────────
EVAL_LLM_MODEL=google/gemma-4-31b-it   # small + cheap, via LiveKit Inference
