{
  "name": "@tca/agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/agent.ts",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import tsx src/agent.ts dev",
    "console": "node --env-file-if-exists=../../.env --import tsx src/agent.ts console",
    "start": "node --env-file-if-exists=../../.env --import tsx src/agent.ts start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@livekit/agents": "^1.9.5",
    "@livekit/agents-plugin-anthropic": "^1.9.5",
    "@livekit/agents-plugin-cartesia": "^1.9.5",
    "@livekit/agents-plugin-deepgram": "^1.9.5",
    "@livekit/agents-plugin-elevenlabs": "^1.9.5",
    "@livekit/agents-plugin-silero": "^1.9.5",
    "@livekit/rtc-node": "^1.2.1",
    "@tca/contracts": "workspace:*",
    "@tca/ticket-providers": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tca/test-helpers": "workspace:*",
    "@types/node": "^22.18.8",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "exports": {
    ".": "./src/agent.ts",
    "./agents": "./src/agents.ts",
    "./state": "./src/session/state.ts",
    "./tools": "./src/tools/index.ts",
    "./voice-config": "./src/voice/config.ts"
  }
}
